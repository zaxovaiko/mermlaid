{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core capabilities for the popover and main windows",
  "windows": [
    "popover",
    "main"
  ],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image",
    "dialog:allow-save",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "core:app:allow-version",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://apps.apple.com/*" }, { "url": "https://dyvertex.com/*" }]
    }
  ]
}