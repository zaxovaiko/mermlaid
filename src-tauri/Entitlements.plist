<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for the Mac App Store. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Save… writes wherever the user picks in the NSSavePanel; without this
         the sandbox denies the write. Nothing else touches the filesystem. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- WKWebView's WebContent XPC helper needs this even though the app itself
         never makes a network request: without it, the sandbox kills every
         WebContent process moments after spawn (crash-looped, ~10s apart),
         so the window stays permanently blank. This is what App Store review
         hit under Guideline 2.1(a) — confirmed locally by signing with the
         sandbox entitlements and watching WebContent crash-loop until this
         key was added. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Signed into the bundle so it matches the identifier in the provisioning
         profile; without these the upload warns that the build is not eligible
         for TestFlight (90886). -->
    <key>com.apple.application-identifier</key>
    <string>J9X92WZMA7.com.dyvertex.mermlaid</string>
    <key>com.apple.developer.team-identifier</key>
    <string>J9X92WZMA7</string>
</dict>
</plist>
